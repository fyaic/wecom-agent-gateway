{
  "name": "wecom-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime-neutral WeCom Bot IM gateway for pluggable Agent kernels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyaic/wecom-agent-gateway.git"
  },
  "homepage": "https://github.com/fyaic/wecom-agent-gateway#readme",
  "bugs": {
    "url": "https://github.com/fyaic/wecom-agent-gateway/issues"
  },
  "keywords": [
    "wecom",
    "enterprise-wechat",
    "agent",
    "gateway",
    "im",
    "openclaw",
    "codex",
    "acp"
  ],
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "test:first-run": "tsx scripts/check-first-run.ts",
    "onboard": "tsx scripts/setup.ts",
    "agent:check": "tsx --env-file-if-exists=.env scripts/check-agent.ts",
    "gateway:status": "tsx --env-file-if-exists=.env scripts/gateway-status.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "doctor:live": "tsx --env-file-if-exists=.env scripts/doctor.ts --live",
    "start": "tsx --env-file-if-exists=.env apps/gateway/src/index.ts",
    "start:checked": "pnpm doctor && pnpm start",
    "configure:allowlist": "tsx scripts/configure-allowlist.ts",
    "enroll:direct": "tsx --env-file-if-exists=.env scripts/enroll-direct-sender.ts",
    "dev": "tsx --env-file-if-exists=.env apps/gateway/src/index.ts",
    "benchmark:codex-app-server": "tsx --env-file-if-exists=.env scripts/benchmark-codex-adapter.ts",
    "smoke:codex-tool": "tsx --env-file-if-exists=.env scripts/smoke-codex-tool.ts",
    "smoke:kimi-adapter": "tsx --env-file-if-exists=.env scripts/smoke-kimi-adapter.ts",
    "smoke:openclaw-adapter": "tsx --env-file-if-exists=.env scripts/smoke-openclaw-adapter.ts",
    "smoke:claude-code-adapter": "tsx scripts/smoke-claude-code-adapter.ts",
    "smoke:pi-adapter": "tsx --env-file-if-exists=.env scripts/smoke-pi-adapter.ts",
    "smoke:pi-image-adapter": "tsx --env-file-if-exists=.env scripts/smoke-pi-image-adapter.ts",
    "smoke:pi-pool": "tsx --env-file-if-exists=.env scripts/smoke-pi-pool.ts",
    "smoke:media-outbox": "tsx --env-file-if-exists=.env scripts/smoke-media-outbox.ts",
    "outbox:status": "tsx --env-file-if-exists=.env scripts/outbox-admin.ts status",
    "outbox:replay-text": "tsx --env-file-if-exists=.env scripts/outbox-admin.ts replay-text",
    "proactive:health": "tsx scripts/proactive-control.ts health",
    "proactive:send": "tsx scripts/proactive-control.ts send",
    "demo:build": "node scripts/build-demo-assets.mjs",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "soak:linux": "tsx --env-file-if-exists=.env scripts/linux-soak.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:m3-quote-approval": "vitest run packages/runtime-contract/src/index.test.ts packages/transport-wecom-bot/test/transport.test.ts packages/channel-core/test/gateway.test.ts packages/adapter-codex/test/app-server-adapter.test.ts packages/storage-sqlite/test/store.test.ts",
    "test:m3-upstream-compatibility": "vitest run packages/transport-wecom-bot/test/transport.test.ts packages/channel-core/test/gateway.test.ts packages/storage-sqlite/test/store.test.ts",
    "test:m3-native-media": "vitest run packages/transport-wecom-bot/test/transport.test.ts packages/channel-core/test/gateway.test.ts packages/adapter-pi/test/adapter.test.ts packages/adapter-codex/test/app-server-adapter.test.ts packages/adapter-acp/test/adapter.test.ts packages/adapter-openclaw/test/adapter.test.ts",
    "verify:real-wecom-ingress": "tsx --env-file-if-exists=.env scripts/verify-real-wecom-ingress.ts",
    "test:m3-owner": "vitest run apps/gateway/test/bot-owner-lock.test.ts scripts/deployment-artifacts.test.ts",
    "conformance:adapter": "tsx packages/adapter-conformance/src/cli.ts",
    "test:m3-conformance": "vitest run packages/adapter-conformance/test/conformance.test.ts examples/clean-room-adapter/test/behavior.test.ts packages/adapter-sdk/test/index.test.ts",
    "test:m3-transport": "vitest run packages/runtime-contract/src/index.test.ts packages/transport-loopback/test/loopback.test.ts packages/transport-conformance/test/conformance.test.ts packages/channel-core/test/gateway.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "public:check": "tsx scripts/check-public-readiness.ts",
    "public:history-check": "tsx scripts/check-public-history.ts",
    "ci": "pnpm format:check && pnpm typecheck && pnpm test && pnpm public:check"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
