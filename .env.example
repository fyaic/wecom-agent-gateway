WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Sender allowlist is intentionally broad: an allowed sender may contact the
# gateway from any conversation. Prefer the scoped variables below.
WECOM_ALLOWED_SENDERS=
WECOM_ALLOWED_CONVERSATIONS=
# Scoped allowlists used by the production gateway.
WECOM_ALLOWED_DIRECT_SENDERS=
WECOM_ALLOWED_GROUP_CONVERSATIONS=
WECOM_MEDIA_TEMP_ROOT=
WECOM_MEDIA_MAX_BYTES=52428800
WECOM_MEDIA_RETENTION_MS=86400000
# Optional static enter_chat welcome; handled by Transport without invoking a Kernel.
WECOM_WELCOME_TEXT=
# Fail closed when empty. These are Agent source directories, never the spool.
WECOM_MEDIA_OUTPUT_ROOTS=
# One active Kernel per Gateway process: codex, kimi, acp, openclaw, pi, or external.
# `acp` accepts any ACP v1 executable.
GATEWAY_ADAPTER=codex
AGENT_WORKING_DIRECTORY=
# An external Adapter is an explicitly trusted in-process module. It receives
# only Adapter-owned JSON and optional RuntimeTools through the factory context.
GATEWAY_EXTERNAL_ADAPTER_MODULE=
GATEWAY_EXTERNAL_ADAPTER_BASE_DIRECTORY=
GATEWAY_EXTERNAL_ADAPTER_CONFIG_JSON={}
# Kimi Code uses the official `kimi acp` stdio server and existing local login.
KIMI_EXECUTABLE=kimi
KIMI_WORKING_DIRECTORY=
KIMI_REQUEST_TIMEOUT_MS=300000
# Generic ACP adapter settings (used only when GATEWAY_ADAPTER=acp).
ACP_ADAPTER_ID=
ACP_EXECUTABLE=
ACP_ARGS_JSON=[]
ACP_WORKING_DIRECTORY=
ACP_REQUEST_TIMEOUT_MS=300000
# Extra environment variable names explicitly forwarded to ACP children.
ACP_AGENT_ENV_ALLOWLIST=
# OpenClaw uses its official Gateway WebSocket client. The initial adapter
# intentionally accepts loopback URLs only; OpenClaw remains a separate service.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_AGENT_ID=
OPENCLAW_CONNECT_TIMEOUT_MS=15000
OPENCLAW_REQUEST_TIMEOUT_MS=30000
OPENCLAW_RUN_TIMEOUT_MS=300000
# Pi uses the official strict-LF JSONL RPC process (`pi --mode rpc`). Extra
# arguments are appended after those fixed RPC arguments.
PI_EXECUTABLE=pi
PI_ARGS_JSON=[]
PI_WORKING_DIRECTORY=
PI_REQUEST_TIMEOUT_MS=30000
PI_RUN_TIMEOUT_MS=300000
# Bounded Pi RPC processes. Same-session turns remain ordered; unrelated
# conversations may run in parallel up to this limit.
PI_MAX_WORKERS=2
# Optional comma-separated additional roots accepted for persisted sessions.
PI_SESSION_ROOTS=
# Extra environment variable names explicitly forwarded to Pi (for example a
# provider API key). Values stay in the local .env and must never be committed.
PI_AGENT_ENV_ALLOWLIST=
CODEX_WORKING_DIRECTORY=
CODEX_ADAPTER=app-server
CODEX_EXECUTABLE=codex
CODEX_RUNTIME_HOME=
CODEX_MODEL=
CODEX_SERVICE_TIER=
CODEX_REASONING_EFFORT=low
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never
CODEX_REQUEST_TIMEOUT_MS=30000
CODEX_APPROVAL_WAIT_TIMEOUT_MS=90000
CODEX_RESPONSES_WEBSOCKET=false
# Experimental Codex dynamic-tool bridge. Disabled by default; the first slice
# exposes only an exact read-only contact search, never arbitrary CLI argv.
WECOM_CLI_TOOLS_ENABLED=false
WECOM_CLI_WRITE_TOOLS_ENABLED=false
WECOM_CLI_EXECUTABLE=wecom-cli
WECOM_CLI_CONFIG_DIR=
WECOM_CLI_TIMEOUT_MS=60000
WECOM_CLI_MAX_OUTPUT_BYTES=262144
# Required only by the explicit read-only contact smoke. Use a local test
# contact and a non-sensitive readable substring expected in the answer.
WECOM_SMOKE_CONTACT_QUERY=
WECOM_SMOKE_CONTACT_EXPECT=
RUNTIME_TOOL_TIMEOUT_MS=60000
RUNTIME_TOOL_MAX_OUTPUT_BYTES=262144
GATEWAY_DATABASE_PATH=data/gateway.db
GATEWAY_LOG_LEVEL=info
# Gateway-owned durable media. Keep it outside Agent-writable source roots.
GATEWAY_MEDIA_SPOOL_ROOT=data/media-spool
GATEWAY_MEDIA_SPOOL_MAX_TOTAL_BYTES=524288000
GATEWAY_OUTBOX_POLL_INTERVAL_MS=1000
GATEWAY_OUTBOX_LEASE_MS=30000
GATEWAY_OUTBOX_MAX_ATTEMPTS=5
GATEWAY_OUTBOX_RETRY_BASE_MS=1000
GATEWAY_OUTBOX_RETRY_MAX_MS=30000
GATEWAY_OUTBOX_BATCH_SIZE=10
GATEWAY_MAX_PENDING_INBOUND_MESSAGES=100
GATEWAY_MAX_PENDING_INBOUND_PER_CONVERSATION=10
GATEWAY_MAX_CONCURRENT_RUNS=8
GATEWAY_APPROVAL_TIMEOUT_MS=300000
GATEWAY_INTERACTION_TIMEOUT_MS=300000
# Optional final-answer actions. Values are bounded callback continuations,
# never shell commands or WeCom card JSON. The selected value resumes the same Agent session.
# Opt-in demo/operations menu. Keep empty in normal production deployments;
# Agent-requested actions and ask-user cards do not require this setting.
GATEWAY_REPLY_ACTIONS_JSON=[]
GATEWAY_REPLY_ACTION_TIMEOUT_MS=86400000
# Long cancellable runs get one sender-scoped control card after this threshold.
GATEWAY_RUN_CONTROL_ENABLED=true
GATEWAY_RUN_CONTROL_AFTER_MS=15000
GATEWAY_RUN_CONTROL_TIMEOUT_MS=300000
# Optional credential-free local control plane. The Unix socket is chmod 0600.
# With exactly one scoped direct/group allowlist entry, aliases `direct` and
# `group` are created automatically. Additional aliases must map only to IDs
# already present in the matching scoped allowlist.
GATEWAY_CONTROL_ENABLED=false
GATEWAY_CONTROL_SOCKET=data/gateway-control.sock
GATEWAY_CONTROL_MAX_REQUEST_BYTES=65536
GATEWAY_CONTROL_REQUEST_TIMEOUT_MS=5000
GATEWAY_PROACTIVE_MAX_TEXT_BYTES=20000
GATEWAY_PROACTIVE_TARGETS_JSON={}
# Optional loopback-only operational endpoints: /livez, /readyz, /metrics.
# Metrics contain aggregate state and bounded enum labels only, never content or IDs.
GATEWAY_OBSERVABILITY_ENABLED=false
GATEWAY_OBSERVABILITY_HOST=127.0.0.1
GATEWAY_OBSERVABILITY_PORT=9464
GATEWAY_OBSERVABILITY_SNAPSHOT_TIMEOUT_MS=2000
GATEWAY_HEALTHCHECK_TIMEOUT_MS=2000
