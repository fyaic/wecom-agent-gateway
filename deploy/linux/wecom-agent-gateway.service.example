[Unit]
Description=Runtime-neutral WeCom Agent Gateway
Documentation=https://github.com/fyaic/wecom-agent-gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wecom-gateway
Group=wecom-gateway
WorkingDirectory=/opt/wecom-agent-gateway
EnvironmentFile=/etc/wecom-agent-gateway/gateway.env
Environment=NODE_ENV=production
Environment=GATEWAY_DATABASE_PATH=/var/lib/wecom-agent-gateway/gateway.db
Environment=GATEWAY_OWNER_LOCK_ROOT=/var/lib/wecom-agent-gateway/owner-locks
Environment=GATEWAY_MEDIA_SPOOL_ROOT=/var/lib/wecom-agent-gateway/media-spool
Environment=GATEWAY_CONTROL_SOCKET=/var/lib/wecom-agent-gateway/gateway-control.sock
Environment=GATEWAY_OBSERVABILITY_ENABLED=true
Environment=GATEWAY_OBSERVABILITY_HOST=127.0.0.1
Environment=GATEWAY_OBSERVABILITY_PORT=9464
StateDirectory=wecom-agent-gateway
StateDirectoryMode=0700
UMask=0077
ExecStartPre=__PNPM_PATH__ doctor
ExecStart=__PNPM_PATH__ start
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=120s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/wecom-agent-gateway
# Add dedicated absolute Kernel workspace/auth paths to ReadWritePaths when the
# selected Adapter legitimately needs them. Never make the whole home writable.

[Install]
WantedBy=multi-user.target
